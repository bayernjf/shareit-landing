---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations } from '../i18n/utils';

const tr = useTranslations(Astro.url);
const title = `404: Page Not Found | ${tr.siteShortName}`;
---

<BaseLayout title={title}>
  <section class="container py-24 text-center md:py-32">
    <p class="font-mono text-sm font-medium uppercase tracking-widest text-brand-600">404</p>
    <h1 class="mt-4 text-3xl font-bold text-ink-900 sm:text-4xl">
      Page not found
    </h1>
    <p class="mt-3 text-ink-500">
      The page you are looking for does not exist or has been moved.
    </p>
    <a href="/" class="btn-primary mt-8">Back to Home</a>
  </section>
</BaseLayout>