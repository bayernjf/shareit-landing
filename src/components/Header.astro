---
import BayjfLink from '@bay/landing-ui/components/BayjfLink.astro';
import StarOnGithub from '@bay/landing-ui/components/StarOnGithub.astro';
import { useTranslations, localizedPath } from '../i18n/utils';
import LanguageSwitcher from './LanguageSwitcher.astro';

const tr = useTranslations(Astro.url);
const locale = tr.htmlLang === 'zh-CN' ? 'zh' : 'en';
const homePath = localizedPath('', locale);

const navItems = [
  { href: `${homePath}#features`, label: tr.navFeatures },
  { href: `${homePath}#faq`, label: tr.navFaq },
  { href: `${homePath}#contact`, label: tr.navContact },
];
---

<header class="sticky top-0 z-40 border-b border-ink-100 bg-white/80 backdrop-blur-md">
  <div class="container flex h-16 items-center justify-between">
    <a href={homePath} class="flex items-center gap-2 font-semibold text-ink-900" aria-label="ShareIt">
      <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-brand-500 text-white">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 20s-7-4.5-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.5-7 10-7 10z"/>
        </svg>
      </span>
      <span class="text-lg tracking-tight">{tr.siteShortName}</span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Main navigation">
      {navItems.map((item) => (
        <a href={item.href} class="rounded-lg px-3 py-2 text-sm text-ink-600 transition hover:bg-ink-50 hover:text-ink-900">
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <LanguageSwitcher />
      <BayjfLink size={18} class="hidden rounded-lg px-3 py-2 text-sm text-ink-600 transition hover:bg-ink-50 hover:text-ink-900 md:inline-flex" />
      <StarOnGithub href="https://github.com/bayernjf/shareit" size={15} class="hidden text-ink-600 md:inline-flex" />
      <a href={`${homePath}#contact`} class="btn-primary hidden sm:inline-flex">{tr.navCta}</a>
      <button
        id="menu-toggle"
        class="inline-flex h-9 w-9 items-center justify-center rounded-lg text-ink-700 hover:bg-ink-50 md:hidden"
        aria-label="Menu"
        aria-expanded="false"
      >
        <svg id="menu-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        <svg id="close-icon" class="hidden" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <nav id="mobile-menu" class="hidden border-t border-ink-100 bg-white md:hidden" aria-label="Mobile navigation">
    <div class="container flex flex-col py-3">
      {navItems.map((item) => (
        <a href={item.href} class="rounded-lg px-3 py-2.5 text-sm text-ink-700 hover:bg-ink-50">{item.label}</a>
      ))}
      <BayjfLink size={18} class="rounded-lg px-3 py-2.5 text-sm text-ink-700 hover:bg-ink-50" />
      <StarOnGithub href="https://github.com/bayernjf/shareit" size={15} class="mt-1 self-start text-ink-700" />
      <a href={`${homePath}#contact`} class="btn-primary mt-2">{tr.navCta}</a>
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');
  const closeIcon = document.getElementById('close-icon');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
    menuIcon?.classList.toggle('hidden', open);
    closeIcon?.classList.toggle('hidden', !open);
  });
</script>