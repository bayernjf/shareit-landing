---
import { useTranslations } from '../../i18n/utils';
import Icon from '../Icon.astro';
const tr = useTranslations(Astro.url);
---

<section id="features" class="py-20 sm:py-24">
  <div class="container">
    <div class="mx-auto max-w-2xl text-center">
      <span class="section-eyebrow">{tr.featuresEyebrow}</span>
      <h2 class="mt-4 text-3xl font-bold tracking-tight text-ink-900 sm:text-4xl">{tr.featuresTitle}</h2>
      <p class="mt-4 text-lg text-ink-500">{tr.featuresSubtitle}</p>
    </div>
    <div class="mt-12 grid gap-6 sm:grid-cols-2">
      {tr.features.map((item) => (
        <article class="card flex gap-4">
          <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-brand-50 text-brand-600">
            <Icon name={item.icon} size={26} />
          </span>
          <div>
            <h3 class="text-lg font-semibold text-ink-900">{item.title}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-ink-500">{item.desc}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
