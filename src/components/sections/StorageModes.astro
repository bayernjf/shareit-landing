---
import { useTranslations } from '../../i18n/utils';
import Icon from '../Icon.astro';
const tr = useTranslations(Astro.url);
---

<section id="storage" class="bg-ink-50 py-20 sm:py-24">
  <div class="container">
    <div class="mx-auto max-w-2xl text-center">
      <span class="section-eyebrow">{tr.storageEyebrow}</span>
      <h2 class="mt-4 text-3xl font-bold tracking-tight text-ink-900 sm:text-4xl">{tr.storageTitle}</h2>
      <p class="mt-4 text-lg text-ink-500">{tr.storageSubtitle}</p>
    </div>
    <div class="mx-auto mt-12 grid max-w-4xl gap-6 md:grid-cols-2">
      <article class="relative rounded-2xl border border-ink-100 bg-white p-8 shadow-sm">
        <h3 class="text-xl font-semibold text-ink-900">{tr.storageFreeName}</h3>
        <p class="mt-3 text-4xl font-bold text-ink-900">{tr.storageFreePrice}</p>
        <ul class="mt-6 space-y-3">
          {tr.storageFreeFeatures.map((f) => (
            <li class="flex items-start gap-2.5 text-sm text-ink-600">
              <span class="mt-0.5 text-brand-500"><Icon name="check" size={18} /></span>
              <span>{f}</span>
            </li>
          ))}
        </ul>
      </article>
      <article class="relative rounded-2xl border-2 border-brand-400 bg-white p-8 shadow-sm">
        <span class="absolute -top-3 right-6 rounded-full bg-brand-500 px-3 py-1 text-xs font-semibold text-white">Pro</span>
        <h3 class="text-xl font-semibold text-ink-900">{tr.storageProName}</h3>
        <p class="mt-3 text-4xl font-bold text-brand-600">{tr.storageProPrice}</p>
        <ul class="mt-6 space-y-3">
          {tr.storageProFeatures.map((f) => (
            <li class="flex items-start gap-2.5 text-sm text-ink-600">
              <span class="mt-0.5 text-brand-500"><Icon name="check" size={18} /></span>
              <span>{f}</span>
            </li>
          ))}
        </ul>
      </article>
    </div>
    <p class="mt-6 text-center text-xs text-ink-400">{tr.storageNote}</p>
  </div>
</section>
