---
import { useTranslations } from '../../i18n/utils';
const tr = useTranslations(Astro.url);
---

<section class="bg-ink-50 py-20 sm:py-24">
  <div class="container">
    <div class="mx-auto max-w-2xl text-center">
      <span class="section-eyebrow">{tr.solutionEyebrow}</span>
      <h2 class="mt-4 text-3xl font-bold tracking-tight text-ink-900 sm:text-4xl">{tr.solutionTitle}</h2>
      <p class="mt-4 text-lg text-ink-500">{tr.solutionSubtitle}</p>
    </div>
    <ol class="mt-12 grid gap-6 md:grid-cols-3">
      {tr.solutionSteps.map((step, i) => (
        <li class="relative rounded-2xl border border-ink-100 bg-white p-7">
          <span class="flex h-10 w-10 items-center justify-center rounded-full bg-brand-500 text-base font-bold text-white">{i + 1}</span>
          <h3 class="mt-4 text-lg font-semibold text-ink-900">{step.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink-500">{step.desc}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
