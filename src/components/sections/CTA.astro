---
import { useTranslations, localizedPath } from '../../i18n/utils';
const tr = useTranslations(Astro.url);
const locale = tr.htmlLang === 'zh-CN' ? 'zh' : 'en';
const homePath = localizedPath('', locale);
---

<section class="relative overflow-hidden bg-brand-500">
  <div class="container py-16 sm:py-20">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">{tr.ctaTitle}</h2>
      <p class="mt-4 text-lg text-brand-50">{tr.ctaSubtitle}</p>
      <div class="mt-8">
        <a href={`${homePath}#contact`} class="inline-flex items-center justify-center rounded-full bg-white px-6 py-3 text-sm font-semibold text-brand-600 shadow-sm transition hover:bg-brand-50">
          {tr.ctaButton}
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>
    </div>
  </div>
</section>