---
import { languages, type Locale } from '../i18n/ui';
import { getLocaleFromUrl, getLocalizedUrl } from '../i18n/utils';

const current = getLocaleFromUrl(Astro.url);
const otherLocale: Locale = current === 'zh' ? 'en' : 'zh';
const href = getLocalizedUrl(Astro.url, otherLocale);
---

<a
  href={href}
  class="inline-flex items-center gap-1.5 rounded-full border border-ink-200 px-3 py-1.5 text-xs font-medium text-ink-600 transition hover:border-ink-300 hover:text-ink-900"
  hreflang={otherLocale}
  aria-label={`Switch to ${languages[otherLocale]}`}
>
  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.5 3 6 3 9s-.5 6.5-3 9c-2.5-2.5-3-6-3-9s.5-6.5 3-9z"/>
  </svg>
  {languages[otherLocale]}
</a>
