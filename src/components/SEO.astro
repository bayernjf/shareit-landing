---
import { translations, type Locale } from '../i18n/ui';
import { localizedPath } from '../i18n/utils';

interface Props {
  /** current locale */
  locale: Locale;
  /** page relative path without locale prefix, e.g. '' or 'features' */
  path?: string;
  /** override title (defaults to site name) */
  title?: string;
  /** override description */
  description?: string;
}

const { locale, path = '', title, description } = Astro.props;
const tr = translations[locale];
const site = Astro.site ?? new URL('https://shareit-landing.pages.dev');
const canonicalURL = new URL(localizedPath(path, locale), site);

// Cross-language hreflang alternates
const alternates = (['zh', 'en'] as Locale[]).map((l) => ({
  hreflang: l === 'zh' ? 'zh-CN' : 'en-US',
  url: new URL(localizedPath(path, l), site).href,
}));

const pageTitle = title ?? tr.siteName;
const pageDescription = description ?? tr.siteDescription;

// JSON-LD structured data
const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'ShareIt',
  url: site.href,
  description: tr.siteDescription,
};

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'ShareIt',
  url: site.href,
  inLanguage: locale === 'zh' ? 'zh-CN' : 'en-US',
};

const appJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'ShareIt',
  applicationCategory: 'MultimediaApplication',
  operatingSystem: 'Web, iOS, Android',
  description: tr.siteDescription,
  offers: [
    {
      '@type': 'Offer',
      name: tr.storageFreeName,
      price: '0',
      priceCurrency: 'CNY',
    },
  ],
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: tr.faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};
---

<!-- Base meta -->
<title>{pageTitle}</title>
<meta name="description" content={pageDescription} />
<link rel="canonical" href={canonicalURL.href} />

<!-- hreflang alternates -->
{alternates.map((alt) => (
  <link rel="alternate" hreflang={alt.hreflang} href={alt.url} />
))}
<link rel="alternate" hreflang="x-default" href={new URL(localizedPath(path, 'en'), site).href} />

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content="ShareIt" />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={pageDescription} />
<meta property="og:url" content={canonicalURL.href} />
<meta property="og:locale" content={locale === 'zh' ? 'zh_CN' : 'en_US'} />
{alternates.map((alt) => (
  <meta property="og:locale:alternate" content={alt.hreflang.replace('-', '_')} />
))}
<meta property="og:image" content={new URL('/og-default.jpg', site).href} />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={pageDescription} />
<meta name="twitter:image" content={new URL('/og-default.jpg', site).href} />

<!-- JSON-LD structured data -->
<script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
<script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
<script type="application/ld+json" set:html={JSON.stringify(appJsonLd)} />
<script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />