---
import { useTranslations } from '../i18n/utils';
import LanguageSwitcher from './LanguageSwitcher.astro';

const tr = useTranslations(Astro.url);
const locale = tr.htmlLang === 'zh-CN' ? 'zh' : 'en';
const year = new Date().getFullYear();
---

<footer id="contact" class="border-t border-ink-100 bg-ink-50">
  <div class="container py-14">
    <div class="grid gap-10 md:grid-cols-4">
      <div class="md:col-span-2">
        <div class="flex items-center gap-2">
          <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-brand-500 text-white">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20s-7-4.5-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.5-7 10-7 10z"/></svg>
          </span>
          <span class="text-lg font-semibold text-ink-900">{tr.siteShortName}</span>
        </div>
        <p class="mt-3 max-w-xs text-sm text-ink-500">{tr.footerTagline}</p>
        <a href={`mailto:${tr.footerContactEmail}`} class="mt-4 inline-flex items-center gap-2 text-sm text-ink-600 hover:text-brand-600">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
          {tr.footerContactEmail}
        </a>
      </div>

      <div>
        <h3 class="text-sm font-semibold text-ink-900">{tr.footerProduct}</h3>
        <ul class="mt-3 space-y-2 text-sm text-ink-500">
          <li><a href={`/${locale}#features`} class="hover:text-brand-600">{tr.navFeatures}</a></li>
          <li><a href={`/${locale}#faq`} class="hover:text-brand-600">{tr.navFaq}</a></li>
          <li><a href={`/${locale}#storage`} class="hover:text-brand-600">{tr.storageEyebrow}</a></li>
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold text-ink-900">{tr.footerCompany}</h3>
        <ul class="mt-3 space-y-2 text-sm text-ink-500">
          <li><a href={`/${locale}#contact`} class="hover:text-brand-600">{tr.footerCompanyContact}</a></li>
          <li class="pt-2"><span class="text-xs text-ink-400">{tr.footerLangLabel}</span></li>
          <li><LanguageSwitcher /></li>
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-col items-center justify-between gap-3 border-t border-ink-200 pt-6 text-xs text-ink-400 sm:flex-row">
      <p>&copy; {year} {tr.footerCopyright}</p>
      <div class="flex gap-4">
        <a href="https://github.com/bayernjf/shareit" target="_blank" rel="noopener noreferrer" class="hover:text-ink-600">GitHub</a>
        <a href={`/${locale}/privacy`} class="hover:text-ink-600">{tr.footerLegalPrivacy}</a>
        <a href={`/${locale}/terms`} class="hover:text-ink-600">{tr.footerLegalTerms}</a>
        <a href="https://bayjf.pages.dev" target="_blank" rel="noopener noreferrer" class="hover:text-ink-600">BayJF</a>
      </div>
    </div>
  </div>
</footer>
